    "@modelcontextprotocol/sdk": "1.32.2",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "zod": "4.6.7"
  },
  "type": "module",
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.5"
  }
