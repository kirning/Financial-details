# MinIO / S3 凭证对象存储配置样例
# 用法：复制为同目录 .env 并填入真实值；.env 已被 .gitignore 排除，绝不提交。
MINIO_ENDPOINT=https://your-minio-endpoint.example.com
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=nanfeng-vouchers
MINIO_REGION=us-east-1
# 经 CF 代理时必须 true（path-style，避免 bucket.<host> 虚拟主机解析）
MINIO_FORCE_PATH_STYLE=true

# 可选：Web 后端监听端口，默认 7300
# PORT=7300

# MCP 服务（Streamable HTTP），默认 http://127.0.0.1:7302/mcp
# MCP_PORT=7302
# MCP_HOST=127.0.0.1
# 远程暴露时必须设置强 token；留空则不鉴权
# MCP_TOKEN=change-me
